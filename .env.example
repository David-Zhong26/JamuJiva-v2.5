# Supabase — used by /api/subscribe, /api/events, and customer accounts.
# Browser key: Project Settings → API Keys → Publishable (sb_publishable_... or the legacy anon JWT).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server only. Never put sb_secret_ or the service_role key in a VITE_ variable.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Password for /admin/events (add/delete events without code)
EVENTS_ADMIN_PASSWORD=change-me

# Stripe webhook signing secret. Payment status is recorded only after this signature checks out.
# Local: stripe listen --forward-to localhost:3001/api/stripe/webhook
# Production endpoint: https://www.jivalivin.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Team password for /admin/orders. Falls back to EVENTS_ADMIN_PASSWORD when unset.
# ORDERS_ADMIN_PASSWORD=change-me

# Use sk_test_... for localhost. Rotate any key that was shared publicly.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe Price IDs (price_...). Also add all of these on Vercel for production checkout.
# Pre-launch Join charges this price and records a pre-order. Local API reads .env, not Vercel.
STRIPE_EARLY_BIRD_PRICE_ID=price_xxx
STRIPE_PRICE_GOLDEN=price_xxx
STRIPE_PRICE_SPICED=price_xxx
STRIPE_PRICE_MIXED_DUO=price_xxx
STRIPE_PRICE_TWO_GOLDEN=price_xxx
STRIPE_PRICE_TWO_SPICED=price_xxx

# Comma-separated Boston-area zips eligible for delivery
DELIVERY_ZIPS=02108,02109,02110

# Where Stripe redirects after payment
# Local: http://localhost:3000
# Vercel Production: https://www.jivalivin.com
CLIENT_URL=http://localhost:3000
API_PORT=3001
